#!/usr/bin/env python3
"""One-command setup for Proving Ground.

Installs the Unity package into a project, builds the MCP server, wires it into your
agent harness, and drops the skill where the harness will read it.

    tools/pg-setup                       detect everything, ask when unsure
    tools/pg-setup --project ~/MyGame    point at a specific Unity project
    tools/pg-setup --harness claude      skip harness detection
    tools/pg-setup --yes                 accept every default, no prompts

Re-running is safe. Existing entries are updated in place and nothing else in your
config files is touched.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PACKAGE = REPO / "packages" / "com.zottiben.provingground"
MCP_DIR = REPO / "mcp"
SKILL = REPO / "skills" / "proving-ground" / "SKILL.md"
PACKAGE_ID = "com.zottiben.provingground"
SERVER_NAME = "proving-ground"

HARNESSES = ("claude", "codex", "pi")

GREEN, YELLOW, RED, DIM, BOLD, OFF = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    GREEN = YELLOW = RED = DIM = BOLD = OFF = ""


def ok(msg: str) -> None:
    print(f"  {GREEN}OK{OFF}   {msg}")


def warn(msg: str) -> None:
    print(f"  {YELLOW}NOTE{OFF} {msg}")


def fail(msg: str) -> None:
    print(f"  {RED}FAIL{OFF} {msg}")


def step(number: int, title: str) -> None:
    print(f"\n{BOLD}[{number}/5] {title}{OFF}")


def ask(question: str, options: list[str], assume_yes: bool) -> str:
    if assume_yes:
        return options[0]
    while True:
        answer = input(f"       {question} [{'/'.join(options)}]: ").strip().lower()
        if answer in options:
            return answer
        if not answer:
            return options[0]


# --- Unity project ------------------------------------------------------------------


def is_unity_project(path: Path) -> bool:
    return (path / "Assets").is_dir() and (path / "ProjectSettings" / "ProjectVersion.txt").is_file()


def find_unity_project(explicit: str | None, assume_yes: bool) -> Path | None:
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not is_unity_project(path):
            fail(f"{path} is not a Unity project (no Assets/ and ProjectSettings/).")
            return None
        return path

    cwd = Path.cwd().resolve()
    for candidate in (cwd, *cwd.parents):
        if is_unity_project(candidate):
            return candidate
        if candidate == candidate.parent:
            break

    if assume_yes:
        return None

    answer = input("       Path to your Unity project (blank to skip): ").strip()
    if not answer:
        return None

    path = Path(answer).expanduser().resolve()
    if not is_unity_project(path):
        fail(f"{path} is not a Unity project.")
        return None
    return path


def install_package(project: Path) -> bool:
    manifest_path = project / "Packages" / "manifest.json"
    if not manifest_path.is_file():
        fail(f"No {manifest_path}.")
        return False

    manifest = json.loads(manifest_path.read_text())
    deps = manifest.setdefault("dependencies", {})
    reference = f"file:{PACKAGE}"

    if deps.get(PACKAGE_ID) == reference:
        ok(f"{PACKAGE_ID} already points at this clone")
        return True

    existing = deps.get(PACKAGE_ID)
    deps[PACKAGE_ID] = reference
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")

    ok(f"{'Updated' if existing else 'Added'} {PACKAGE_ID} in Packages/manifest.json")
    print(f"       {DIM}-> {reference}{OFF}")
    return True


# --- MCP server ---------------------------------------------------------------------


def build_server() -> Path | None:
    """Creates the server's virtualenv and returns the launcher path."""
    launcher = MCP_DIR / ".venv" / "bin" / "proving-ground-mcp"
    if os.name == "nt":
        launcher = MCP_DIR / ".venv" / "Scripts" / "proving-ground-mcp.exe"

    if launcher.is_file():
        ok("MCP server already built")
        return launcher

    uv = shutil.which("uv")
    try:
        if uv:
            subprocess.run([uv, "sync"], cwd=MCP_DIR, check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        else:
            warn("uv not found, falling back to python -m venv")
            venv = MCP_DIR / ".venv"
            subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True,
                           stdout=subprocess.DEVNULL)
            pip = venv / ("Scripts/pip.exe" if os.name == "nt" else "bin/pip")
            subprocess.run([str(pip), "install", "-q", "-e", str(MCP_DIR)], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except subprocess.CalledProcessError as e:
        fail(f"Could not build the MCP server: {(e.stderr or b'').decode()[:300]}")
        return None

    if not launcher.is_file():
        fail(f"Build finished but {launcher} is missing.")
        return None

    ok("Built the MCP server")
    return launcher


# --- harness detection --------------------------------------------------------------


def detect_harnesses(project: Path | None) -> list[str]:
    found = []
    for name in HARNESSES:
        marks = [Path.home() / f".{name}"]
        if project:
            marks.append(project / f".{name}")
        if name == "pi" and project:
            marks.append(project / ".agents")

        if any(m.exists() for m in marks) or shutil.which(name):
            found.append(name)
    return found


def choose_harnesses(explicit: str | None, project: Path | None, assume_yes: bool) -> list[str]:
    if explicit:
        chosen = [h.strip().lower() for h in explicit.split(",")]
        unknown = [h for h in chosen if h not in HARNESSES]
        if unknown:
            fail(f"Unknown harness {unknown}. Choose from: {', '.join(HARNESSES)}.")
            return []
        return chosen

    detected = detect_harnesses(project)

    if not detected:
        warn("No harness detected.")
        if assume_yes:
            return []
        answer = input(f"       Which are you using? [{'/'.join(HARNESSES)}/skip]: ").strip().lower()
        return [answer] if answer in HARNESSES else []

    if len(detected) == 1:
        ok(f"Detected {detected[0]}")
        return detected

    ok(f"Detected {', '.join(detected)}")
    if assume_yes:
        return detected

    answer = input(f"       Configure which? [{'/'.join(detected)}/all]: ").strip().lower()
    if answer in ("", "all"):
        return detected
    return [answer] if answer in detected else detected


# --- harness configuration ----------------------------------------------------------


def configure_claude(project: Path, launcher: Path) -> None:
    config = project / ".mcp.json"
    data = json.loads(config.read_text()) if config.is_file() else {}
    servers = data.setdefault("mcpServers", {})
    servers[SERVER_NAME] = {"command": str(launcher), "args": []}
    config.write_text(json.dumps(data, indent=2) + "\n")
    ok(f"MCP server registered in {config.relative_to(project)}")

    install_skill(project / ".claude" / "skills" / SERVER_NAME / "SKILL.md", project)


def configure_pi(project: Path, launcher: Path) -> None:
    config = project / ".pi" / "mcp.json"
    config.parent.mkdir(parents=True, exist_ok=True)
    data = json.loads(config.read_text()) if config.is_file() else {}
    servers = data.setdefault("mcpServers", {})
    servers[SERVER_NAME] = {
        "command": str(launcher),
        "args": [],
        "transport": "stdio",
        "lifecycle": "lazy",
        "directTools": True,
    }
    config.write_text(json.dumps(data, indent=2) + "\n")
    ok(f"MCP server registered in {config.relative_to(project)}")

    install_skill(project / ".agents" / "skills" / SERVER_NAME / "SKILL.md", project)


def configure_codex(project: Path, launcher: Path) -> None:
    config = project / ".codex" / "config.toml"
    config.parent.mkdir(parents=True, exist_ok=True)
    existing = config.read_text() if config.is_file() else ""

    block = (
        f"[mcp_servers.{SERVER_NAME}]\n"
        f'command = "{launcher}"\n'
        f"args = []\n"
        f"startup_timeout_sec = 60\n"
    )

    # Replace the existing block in place rather than appending a duplicate, which Codex
    # would reject as a repeated key.
    pattern = re.compile(
        rf"^\[mcp_servers\.{re.escape(SERVER_NAME)}\]$.*?(?=^\[|\Z)",
        re.MULTILINE | re.DOTALL,
    )

    if pattern.search(existing):
        updated = pattern.sub(block, existing)
    else:
        separator = "" if not existing or existing.endswith("\n\n") else ("\n" if existing.endswith("\n") else "\n\n")
        updated = existing + separator + block

    config.write_text(updated)
    ok(f"MCP server registered in {config.relative_to(project)}")
    warn("Codex only loads project config from trusted projects. Run 'codex' here once and trust it.")

    # Codex reads skills from its home directory, not from the project.
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    install_skill(codex_home / "skills" / SERVER_NAME / "SKILL.md", project)
    add_agents_pointer(project)


def install_skill(destination: Path, project: Path) -> None:
    if not SKILL.is_file():
        fail(f"Skill not found at {SKILL}")
        return

    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(SKILL, destination)

    try:
        shown = destination.relative_to(project)
    except ValueError:
        shown = destination
    ok(f"Skill installed at {shown}")


def add_agents_pointer(project: Path) -> None:
    """Codex loads AGENTS.md automatically; a one-line pointer makes the skill discoverable."""
    agents = project / "AGENTS.md"
    marker = "<!-- proving-ground -->"
    line = (
        f"{marker}\n"
        "## Proving Ground\n\n"
        "This project uses the Proving Ground plugin for Unity. Load the `proving-ground` "
        "skill before building, changing or verifying anything in the game.\n"
    )

    existing = agents.read_text() if agents.is_file() else ""
    if marker in existing:
        ok("AGENTS.md already points at the skill")
        return

    agents.write_text((existing + "\n\n" if existing else "") + line)
    ok(f"{'Updated' if existing else 'Created'} AGENTS.md with a pointer to the skill")


CONFIGURE = {"claude": configure_claude, "codex": configure_codex, "pi": configure_pi}


# --- main ---------------------------------------------------------------------------


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True, description="Set up Proving Ground.")
    parser.add_argument("--project", help="Path to the Unity project.")
    parser.add_argument("--harness", help=f"Comma separated: {', '.join(HARNESSES)}.")
    parser.add_argument("--yes", action="store_true", help="Accept defaults, never prompt.")
    parser.add_argument("--skip-unity", action="store_true", help="Do not touch the Unity manifest.")
    args = parser.parse_args()

    print(f"\n{BOLD}Proving Ground setup{OFF}")
    print(f"{DIM}{REPO}{OFF}")

    if not PACKAGE.is_dir():
        fail(f"Package not found at {PACKAGE}. Run this from inside the cloned repo.")
        return 1

    step(1, "Locate the Unity project")
    project = None if args.skip_unity else find_unity_project(args.project, args.yes)
    if project:
        ok(f"Using {project}")
    else:
        warn("No Unity project. The package step will be skipped.")

    step(2, "Install the Unity package")
    if project:
        install_package(project)
    else:
        warn("Skipped.")

    step(3, "Build the MCP server")
    launcher = build_server()
    if launcher is None:
        return 1

    step(4, "Configure your harness")
    harnesses = choose_harnesses(args.harness, project, args.yes)

    if not harnesses:
        warn("No harness configured. See the README for manual steps.")
    elif not project:
        fail("Harness config is written into the project, so a Unity project is required.")
        harnesses = []
    else:
        for harness in harnesses:
            print(f"\n       {BOLD}{harness}{OFF}")
            CONFIGURE[harness](project, launcher)

    step(5, "Next steps")
    print(f"""
  1. Open the Unity project. The package compiles on import.
  2. Enable the bridge:  {BOLD}Tools > Proving Ground > Agent Bridge > Enable{OFF}
  3. Initialise contracts: {BOLD}Tools > Proving Ground > Initialise Project{OFF}
     (or just ask your agent to do it)
  4. Start your harness in {project if project else 'the project'} and prompt it:

     {DIM}"Check the project settings, then build me a greybox first person
      shooter. Use a scene recipe for the level and verify with Proving
      Ground at every step."{OFF}

  Tag your player {BOLD}Player{OFF} so the harness can find it.
""")
    return 0


if __name__ == "__main__":
    sys.exit(main())
