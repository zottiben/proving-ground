#!/usr/bin/env bash
# Proving Ground CLI. Talks to the agent bridge in a running Unity Editor.
#
#   pg health
#   pg methods
#   pg init [genre]
#   pg check [project|content|audioassets|audio|scene|ui|all]
#   pg gate
#   pg milestone <id>
#   pg digest | view | capture | events | scenarios
#   pg norms <genre>
#   pg play [on|off]
#   pg scenario <name>
#   pg probe [seconds]
#   pg status
#   pg call <Method> [jsonArgs]
#   pg shutdown            (headless serve mode only)
set -uo pipefail

URL="${PROVING_GROUND_URL:-http://127.0.0.1:8787}"

die() { echo "$*" >&2; exit 1; }

command -v curl >/dev/null || die "curl is required."

call() {
  local method="$1"
  local args="${2:-{\}}"
  local response
  response=$(curl -s -m 900 -X POST -H 'Content-Type: application/json' \
    -d "{\"method\":\"$method\",\"args\":$args}" "$URL/call") || die "Could not reach $URL"

  if [[ -z "$response" ]]; then
    die "Empty response from $URL. Is the Editor open with the bridge enabled?"
  fi
  echo "$response"
}

# Renders a report as text when the response is one, otherwise passes it through.
render() {
  python3 - <<'PY'
import json, sys
raw = sys.stdin.read()
try:
    report = json.loads(raw)
except json.JSONDecodeError:
    print(raw); raise SystemExit(0)

if not isinstance(report, dict) or "findings" not in report:
    print(json.dumps(report, indent=2) if isinstance(report, (dict, list)) else raw)
    raise SystemExit(0)

print(report.get("summary") or report.get("tool"))
if not report.get("ok", True):
    print("  could not run:", report.get("error")); raise SystemExit(1)

rank = {"Blocker": 3, "Fail": 2, "Warn": 1, "Info": 0}
for f in sorted(report["findings"], key=lambda f: rank.get(f.get("severity"), 0), reverse=True):
    print(f"  [{f.get('severity')}] {f.get('id')}: {f.get('message')}")
    if f.get("subject"): print(f"      at {f['subject']}")
    if f.get("expected") or f.get("actual"):
        print(f"      expected {f.get('expected')}, got {f.get('actual')}")
    if f.get("remedy"): print(f"      {f['remedy']}")

raise SystemExit(0 if report.get("passed", True) else 1)
PY
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  health)    curl -s -m 15 "$URL/health" || die "No Editor at $URL"; echo ;;
  methods)   curl -s -m 15 "$URL/methods" | python3 -m json.tool ;;
  shutdown)  curl -s -m 15 "$URL/shutdown"; echo ;;

  init)      call Init "{\"genre\":\"${1:-fps}\"}" | render ;;
  survey)    call Survey | render ;;
  gate)      call Gate | render ;;
  milestone) [[ $# -ge 1 ]] || die "Usage: pg milestone <id>"
             call Milestone "{\"milestoneId\":\"$1\"}" | render ;;

  check)
    case "${1:-all}" in
      project)     call CheckProject ;;
      content)     call CheckContent ;;
      audioassets) call CheckAudioAssets ;;
      audio)       call CheckAudio ;;
      scene)       call CheckScene ;;
      ui)          call CheckUi ;;
      all)         call CheckAll ;;
      *)           die "Unknown check '$1'. Use project, content, audioassets, audio, scene, ui or all." ;;
    esac | render ;;

  digest)    call Digest ;;
  view)      call View ;;
  capture)   call Capture "{\"name\":\"${1:-capture}\"}" ;;
  events)    call Events ;;
  scenarios) call Scenarios ;;
  norms)     [[ $# -ge 1 ]] || die "Usage: pg norms <genre>"; call Norms "{\"genre\":\"$1\"}" ;;

  play)
    if [[ "${1:-on}" == "off" ]]; then call ExitPlayMode; else call EnterPlayMode; fi; echo ;;

  scenario)  [[ $# -ge 1 ]] || die "Usage: pg scenario <name>"
             call RunScenario "{\"name\":\"$1\"}"; echo
             echo "Started. Poll with: pg status" ;;

  probe)     call RunProbe "{\"seconds\":${1:-60}}"; echo
             echo "Started. Poll with: pg status" ;;

  status)    call RunStatus | python3 -m json.tool ;;

  call)      [[ $# -ge 1 ]] || die "Usage: pg call <Method> [jsonArgs]"
             call "$1" "${2:-{\}}" ;;

  help|--help|-h)
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0" ;;

  *) die "Unknown command '$cmd'. Try: pg help" ;;
esac
